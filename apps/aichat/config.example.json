{
    "onebot": {
        "url": "ws://127.0.0.1:3001/",
        "accessToken": "${QB_ONEBOT_TOKEN}",
        "requestTimeoutMs": 60000,
        "reconnect": true
    },
    "bot": {
        "name": "小助手",
        "trigger": {
            "requireAt": true,
            "wakeWords": []
        },
        "recordAllGroupMessages": true,
        "replyQuote": true,
        "atSender": false,
        "groups": {
            "whitelist": [],
            "blacklist": []
        },
        "owners": [],
        "maxReplyChars": 1200,
        "chunkDelayMs": 400,
        "notifyOnError": false
    },
    "context": {
        "maxMessages": 20,
        "maxTokens": 20000,
        "maxCharsPerMessage": 2000,
        "maxGroups": 200,
        "idleTtlMinutes": 720,
        "includeSpeakerName": true
    },
    "llm": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "${LLM_API_KEY}",
        "model": "deepseek-chat",
        "temperature": 0.8,
        "topP": 1,
        "maxTokens": 1024,
        "timeoutMs": 60000,
        "retries": 1,
        "extraHeaders": {},
        "extraBody": {}
    },
    "prompt": {
        "dir": "prompts",
        "main": "system.md",
        "perGroup": {}
    },
    "logging": {
        "level": "info"
    }
}
