{
    "onebot": {
        "url": "ws://127.0.0.1:3001/",
        "accessToken": "${QB_ONEBOT_TOKEN}",
        "requestTimeoutMs": 60000,
        "reconnect": true
    },
    "bot": {
        "name": "小助手",
        "trigger": {
            "requireAt": true,
            "wakeWords": []
        },
        "recordAllGroupMessages": true,
        "replyQuote": true,
        "atSender": false,
        "groups": {
            "whitelist": [],
            "blacklist": []
        },
        "owners": [],
        "maxReplyChars": 1200,
        "splitParagraphs": true,
        "sentenceSplitAt": 40,
        "triggerMarker": "@你",
        "maxReplySegments": 4,
        "chunkDelayMs": 400,
        "notifyOnError": false
    },
    "context": {
        "maxMessages": 20,
        "maxTokens": 20000,
        "maxCharsPerMessage": 2000,
        "maxGroups": 200,
        "idleTtlMinutes": 720,
        "includeSpeakerName": true
    },
    "llm": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "${LLM_API_KEY}",
        "model": "deepseek-chat",
        "temperature": 0.8,
        "topP": 1,
        "maxTokens": 1024,
        "timeoutMs": 60000,
        "retries": 1,
        "extraHeaders": {},
        "extraBody": {}
    },
    "prompt": {
        "dir": "prompts",
        "main": "system.md",
        "perGroup": {},
        "hotReload": true
    },
    "vision": {
        "enabled": true,
        "maxImages": 4,
        "maxBytes": 5242880
    },
    "github": {
        "enabled": true,
        "intervalSeconds": 300,
        "token": "${GITHUB_TOKEN}",
        "stateFile": "data/github-state.json",
        "postExisting": false,
        "targets": [
            {
                "repo": "rikkahub/rikkahub",
                "groupIds": [
                    628101497
                ],
                "kinds": [
                    "release"
                ]
            }
        ]
    },    "autoReplies": {
        "enabled": true,
        "rules": [
            {
                "userIds": [
                    1609403959
                ],
                "groupIds": [
                    628101497
                ],
                "faces": [
                    "是钢卷",
                    "吃芒果",
                    "偷听",
                    "冲冲冲",
                    "摆烂",
                    "凝视"
                ],
                "cooldownSeconds": 120,
                "avoidRepeat": true
            }
        ]
    },
    "logging": {
        "level": "info"
    }
}








